[Unit]
Description=Poznamky (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=poznamky
Group=poznamky
WorkingDirectory=/opt/self_mem/poznamky
EnvironmentFile=/etc/poznamky.env
# 1 worker kvuli 1 GB RAM sdilene s PostgreSQL; vlakna staci pro osobni provoz
ExecStart=/opt/self_mem/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5
MemoryMax=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/poznamky

[Install]
WantedBy=multi-user.target
